[layer_names]

2d_render/layer_1="player"
2d_render/layer_2="objects"
2d_render/layer_3="creatures"
2d_physics/layer_1="ground"
2d_navigation/layer_1="pursuit"
2d_physics/layer_2="walls"
2d_physics/layer_3="creatures"
2d_physics/layer_4="objects"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/lossless_compression/force_png=true
textures/webp_compression/lossless_compression_factor=100.0
shader_compiler/shader_cache/compress=false
anti_aliasing/screen_space_roughness_limiter/enabled=false
lightmapping/primitive_meshes/texel_size=0.999
anti_aliasing/quality/screen_space_aa=1
2d/sdf/oversize=0
lights_and_shadows/stdout/print_fps=true
2d/quality/screen_space_aa=0
2d/shader_cache/compress=true
2d/webp_compression/lossless_compression_factor=25
2d/stretch/scale_mode="integer"
