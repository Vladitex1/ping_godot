[sub_resource type="GDScript" id="GDScript_3uo6e"]
script/source = "extends CharacterBody2D


static var speed: int = 150
static var delta: int = 1
static var sprint: int = 150
static var tempsprint: int = sprint
static var action_tougle: bool = false

static var door_tougle: bool = false
static var door_tougle_opener: bool = true

static var shop_tougle: bool = false
static var shop_tougle_opener: bool = false

###	tougle - активность зоны колизии
### tougle_opener - переключатель двери


@onready var _animated_sprite = $AnimatedSprite2D
@onready var _interactive = $Interactive
@onready var door_tex_1 = $\"../Level/Door1/Textures/Door1\"
@onready var door_tex_2 = $\"../Level/Door1/Textures/Door2\"
@onready var door_colision = $\"../Level/Door1/StaticBody2D\"
@onready var door_colision2 = $\"../Level/Door1/StaticBody2D/CollisionShape2D\"


############################################################# MOVEMENT
func movement(): #передвижение
	var input_dir = Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")
	if Input.is_action_pressed(\"move_shift\"):
		sprint	= tempsprint
	else:
		sprint = 0
		
	velocity = input_dir * (speed + sprint)
############################################################# ANIMATIONS
func animation():
	if Input.is_action_pressed(\"move_right\"):
		_animated_sprite.play(\"walk_right\")
	if Input.is_action_pressed(\"move_left\"):
		_animated_sprite.play(\"walk_left\")
	if Input.is_action_pressed(\"move_up\"):
		_animated_sprite.play(\"walk_up\")
	if Input.is_action_pressed(\"move_down\"):
		_animated_sprite.play(\"walk_down\")
	if !Input.is_action_pressed(\"move_left\") && !Input.is_action_pressed(\"move_right\") && !Input.is_action_pressed(\"move_down\") && !Input.is_action_pressed(\"move_up\"):
		_animated_sprite.stop()
############################################################# ACTIONBUTTON
func actions():
	if action_tougle == true:
		_interactive.show()
		if Input.is_action_just_released(\"press_key_event_on\") and door_tougle: #двери
			if door_tougle_opener:
				print(\"тык\")
				door_tex_1.hide()
				door_tex_2.hide()
				door_colision.set_deferred(\"collision_layer\",false)
				door_tougle_opener = false
			else:
				print(\"тык2\")
				door_tex_1.show()
				door_tex_2.show()
				door_colision.set_deferred(\"collision_layer\",true)
				door_tougle_opener = true
		if Input.is_action_just_released(\"press_key_event_on\") and shop_tougle:
			print(\"магаз вкл\")
	else:
		_interactive.hide()
############################################################# SHOP

func _on_shop_area_entered(area):
	print(\"вход в территорию магазина\")
	action_tougle = true 
	shop_tougle = true
func _on_shop_area_exited_(area):
	print(\"выход из территории магазина\")
	action_tougle = false
	shop_tougle = false

############################################################# DOORS
func _on_door_area_entered(area):
	print(\"вход в территорию двери\")
	action_tougle = true
	door_tougle = true
	
func _on_door_area_exited(area):
	print(\"выход из территории двери\")
	action_tougle = false
	door_tougle = false
############################################################# MAIN
func _physics_process(delta):
	movement()
	move_and_slide()
	animation()
	actions()
	

"

